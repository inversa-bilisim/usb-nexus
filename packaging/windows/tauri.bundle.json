{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/usbnexus"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English",
          "Turkish",
          "German",
          "Spanish",
          "French",
          "Italian",
          "PortugueseBR",
          "Russian",
          "Japanese",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "../../../packaging/windows/hooks.nsh",
        "template": "../../../packaging/windows/installer.nsi"
      }
    },
    "resources": {
      "../../../packaging/windows/drivers/": "drivers/",
      "../../../packaging/windows/usbip-win2/": "usbip-win2/"
    }
  }
}
