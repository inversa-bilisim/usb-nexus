{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "USB Nexus",
  "version": "0.1.2",
  "identifier": "org.usbnexus.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "USB Nexus",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Secure USB over IP",
    "longDescription": "Share USB devices across the network with encryption, PIN pairing, automatic discovery and reconnection.",
    "copyright": "Copyright (C) 2026 USB Nexus contributors. GPL-3.0-or-later.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
