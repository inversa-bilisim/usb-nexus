{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/usbnexus"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "../../../packaging/windows/hooks.nsh"
      }
    },
    "resources": {
      "../../../packaging/windows/drivers/": "drivers/",
      "../../../packaging/windows/usbip-win2/": "usbip-win2/"
    }
  }
}
