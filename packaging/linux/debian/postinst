#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# Group whose members may control the service from the desktop app.
if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers usbnexus.conf || true
elif ! getent group usbnexus >/dev/null 2>&1; then
    groupadd --system usbnexus || true
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable usbnexus.service >/dev/null 2>&1 || true
    systemctl restart usbnexus.service || true
fi

# The usbip kernel modules ship with the kernel on most distributions; on
# Ubuntu cloud kernels and Fedora/RHEL they are a separate package. The
# service and the app point this out too; this is just an early hint.
if command -v modinfo >/dev/null 2>&1 && ! modinfo -n usbip-host >/dev/null 2>&1; then
    echo "USB Nexus: the usbip-host/vhci-hcd kernel modules were not found for kernel $(uname -r)."
    if [ -r /etc/os-release ] && grep -qi '^ID=ubuntu' /etc/os-release; then
        echo "USB Nexus: install them with: sudo apt install linux-modules-extra-$(uname -r)"
    fi
fi

if [ "$1" = "configure" ] && [ -z "$2" ]; then
    echo "USB Nexus: add desktop users to the 'usbnexus' group: sudo usermod -aG usbnexus <user>"
fi
exit 0
