<!-- USB Nexus service. Installed to /Library/LaunchDaemons/. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.usbnexus.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/usbnexus</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/Library/Logs/USB Nexus/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/USB Nexus/daemon.log</string>
</dict>
</plist>
